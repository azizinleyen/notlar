# Example environment variables for Notlar
# Copy this file to .env only on your own computer. Never commit .env.

# Speech-to-text (default: Groq Whisper large-v3-turbo)
STT_PROVIDER=groq
GROQ_API_KEY=
STT_MODEL=whisper-large-v3-turbo

# AI providers (configure only the providers you use)
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Default language: auto, tr, en, and so on
DEFAULT_LANGUAGE=auto
